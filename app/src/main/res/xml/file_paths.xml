<?xml version="1.0" encoding="utf-8"?>
<!--
    Only these two directories are shared. A config archive carries the router's whole
    configuration, so nothing else in the app's storage is reachable through the provider;
    the AI reports are diagnostics the operator chose to export, and live beside them.
-->
<paths>
    <files-path name="backups" path="backups/" />
    <files-path name="reports" path="reports/" />
</paths>
