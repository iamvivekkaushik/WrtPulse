<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

        <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WrtPulse">
        <!-- Rotation, fold/unfold, split-screen and night-mode flips recompose in place instead
             of recreating the Activity. The whole app state (destination, open sheets, typed
             input, terminal shells) lives in the composition, so a recreate would drop the user
             back to the router list and lose whatever they had typed. -->
        <!-- adjustResize because with the mode left unset One UI pans the whole window up for
             the keyboard while the setup screen's own imePadding() is already making room for
             it. Everything then moves twice: the step bar slides under the status bar, Connect
             lands on top of the password field, and a keyboard-sized gap opens under the
             button. Resizing leaves the insets to Compose, which is the only one measuring. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WrtPulse"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the config backup leave the app through a share sheet. A backup that only
             exists on the router being reflashed is not a backup. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>